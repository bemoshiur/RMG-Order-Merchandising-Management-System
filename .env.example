# Copy to .env and fill in.
# DATABASE_URL = connection used by the app at runtime.
#   - On Vercel use the Neon POOLED host (…-pooler.…) to survive serverless concurrency.
#   - Locally the direct host is fine.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# DIRECT_URL = non-pooled host, used ONLY by `prisma migrate`. On Neon this is the
# host WITHOUT "-pooler". Locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Daily alert cron (GET/POST /api/cron/alerts with header: Authorization: Bearer $CRON_SECRET).
# If unset, the endpoint fails closed (503). Generate with: openssl rand -base64 32
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Optional email channel for alert digests. Without RESEND_API_KEY, digests log only.
# RESEND_API_KEY=""
# ALERT_EMAIL_FROM="alerts@example.com"

# Absolute app URL (used for EPS payment redirect callbacks).
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# --- Branding (all optional; defaults render "PulseOMS") ---
# The wordmark renders MARK immediately followed by NAME. For a two-word brand like
# "Acme Sourcing", set MARK="Acme" and NAME=" Sourcing" (note the leading space).
# NEXT_PUBLIC_BRAND_MARK="Pulse"     # accent part of the wordmark + PWA short name
# NEXT_PUBLIC_BRAND_NAME="OMS"       # plain part of the wordmark (may start with a space)
# NEXT_PUBLIC_BRAND_BADGE="P"        # short monogram inside the square icon/badge
# NEXT_PUBLIC_BRAND_URL=""           # optional marketing link on the login screen (hidden if empty)

# --- Seed overrides (used only by `npm run db:seed`; keep real values OUT of the repo) ---
# SEED_COMPANY_NAME="Demo Sourcing"
# SEED_COMPANY_SLUG="demo"
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_SUPERADMIN_EMAIL="super@example.com"   # set your real platform super-admin email here (privately)

# --- Subscription billing via EPS (eps.com.bd) ---
# Billing/subscription UI (nav link, settings link, /billing page, licence paywall) is HIDDEN
# unless this is exactly "1". Leave unset to hide billing entirely.
# BILLING_ENABLED="1"
# SAFETY: keep "1" everywhere except production — when 1, EPS hard-refuses to charge.
STAGING_PAYMENT_BLOCK="1"
# EPS hosted-checkout credentials (provider-issued). Leave blank to disable payments.
EPS_MERCHANT_ID=""
EPS_STORE_ID=""
EPS_USERNAME=""
EPS_PASSWORD=""
EPS_HASH_KEY=""
# Optional: defaults to https://pgapi.eps.com.bd. Set EPS_SANDBOX="1" for sandbox.
# EPS_BASE_URL=""
# EPS_SANDBOX=""
